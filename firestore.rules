rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================
    // Helper Functions
    // ============================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isActive() {
      return isAuthenticated() && getUserData().status == 'active';
    }
    
    function hasRole(role) {
      return isActive() && getUserData().role == role;
    }
    
    function isAdmin() {
      return hasRole('admin');
    }
    
    function isManager() {
      return hasRole('manager');
    }
    
    function isRep() {
      return hasRole('rep');
    }
    
    function userBelongsToOffice(officeId) {
      return isActive() && officeId in getUserData().officeIds;
    }
    
    // ============================================
    // Default: Deny all
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
    
    // ============================================
    // Users Collection
    // ============================================
    match /users/{userId} {
      allow read: if isActive() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (isManager() && userBelongsToOffice(resource.data.primaryOfficeId))
      );
      
      allow write: if isAdmin();
    }
    
    // ============================================
    // Leads Collection
    // ============================================
    match /leads/{leadId} {
      allow read: if isActive() && (
        isAdmin() ||
        (isManager() && userBelongsToOffice(resource.data.officeId)) ||
        (isRep() && request.auth.uid == resource.data.assignedRepId && userBelongsToOffice(resource.data.officeId))
      );
      
      // Only admins and managers can write leads
      // Reps have limited write access through server actions
      allow write: if isActive() && (
        isAdmin() ||
        (isManager() && userBelongsToOffice(resource.data.officeId))
      );
    }
    
    // ============================================
    // Activities Subcollection
    // ============================================
    match /leads/{leadId}/activities/{activityId} {
      allow read: if isActive();
      // Activities are append-only via server actions
      allow write: if false;
    }
    
    // ============================================
    // Follow-ups Collection
    // ============================================
    match /followUps/{followUpId} {
      allow read: if isActive() && (
        isAdmin() ||
        (isManager() && userBelongsToOffice(resource.data.officeId)) ||
        (isRep() && request.auth.uid == resource.data.assignedRepId)
      );
      
      allow write: if isActive() && (
        isAdmin() ||
        (isManager() && userBelongsToOffice(resource.data.officeId))
      );
    }
    
    // ============================================
    // Survey Sessions Collection
    // ============================================
    // Server-authoritative writes; client reads restricted by office/role
    match /surveySessions/{sessionId} {
      allow read: if isActive() && (
        isAdmin() ||
        (isManager() && userBelongsToOffice(resource.data.officeId)) ||
        (isRep() && request.auth.uid == resource.data.repUserId && userBelongsToOffice(resource.data.officeId))
      );
      
      // Only server-side writes allowed (via Admin SDK bypass)
      // Client writes denied; all mutations go through API routes
      allow write: if false;
    }
    
    // ============================================
    // Survey Responses Subcollection
    // ============================================
    match /surveySessions/{sessionId}/responses/{responseId} {
      allow read: if isActive() && (
        isAdmin() ||
        (isManager() && userBelongsToOffice(get(/databases/$(database)/documents/surveySessions/$(sessionId)).data.officeId)) ||
        (isRep() && request.auth.uid == get(/databases/$(database)/documents/surveySessions/$(sessionId)).data.repUserId)
      );
      
      // Server-authoritative writes only
      allow write: if false;
    }
    
    // ============================================
    // Imports Collection
    // ============================================
    match /imports/{importId} {
      allow read: if isActive() && (isAdmin() || isManager());
      allow write: if isActive() && (isAdmin() || isManager());
    }
    
    // ============================================
    // Offices Collection
    // ============================================
    match /offices/{officeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // ============================================
    // Teams Collection
    // ============================================
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // ============================================
    // Settings Collection
    // ============================================
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // ============================================
    // Audit Events Collection
    // ============================================
    match /auditEvents/{eventId} {
      allow read: if isActive() && (isAdmin() || isManager());
      allow write: if isActive() && (isAdmin() || isManager());
    }
    
    // ============================================
    // Sheet Sync Jobs Collection
    // ============================================
    match /sheetSyncJobs/{jobId} {
      allow read: if isActive() && (isAdmin() || isManager());
      allow write: if isActive() && (isAdmin() || isManager());
    }
  }
}
