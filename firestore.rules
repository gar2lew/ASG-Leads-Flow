rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================
    // Helper Functions
    // ============================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Get user document data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Check if user is active
    function isActive() {
      return isAuthenticated() && getUserData().status == 'active';
    }
    
    // Check if user has specific role
    function hasRole(role) {
      return isActive() && getUserData().role == role;
    }
    
    // Check if user is admin
    function isAdmin() {
      return hasRole('admin');
    }
    
    // Check if user is manager
    function isManager() {
      return hasRole('manager');
    }
    
    // Check if user is rep
    function isRep() {
      return hasRole('rep');
    }
    
    // Check if user belongs to office
    function userBelongsToOffice(officeId) {
      return isActive() && officeId in getUserData().officeIds;
    }
    
    // ============================================
    // Default: Deny all
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
    
    // ============================================
    // Users Collection
    // ============================================
    match /users/{userId} {
      // Users can read their own profile
      // Admins and managers can read profiles for their offices
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (isManager() && userBelongsToOffice(resource.data.primaryOfficeId))
      );
      
      // Only admins can create/update users
      allow write: if isAdmin();
    }
    
    // ============================================
    // Leads Collection
    // ============================================
    match /leads/{leadId} {
      // Reps can read assigned leads in their office
      // Managers can read leads in their offices
      // Admins can read all leads
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isManager() && userBelongsToOffice(resource.data.officeId)) ||
        (isRep() && request.auth.uid == resource.data.assignedRepId && userBelongsToOffice(resource.data.officeId))
      );
      
      // Only managers and admins can write leads
      allow write: if isAuthenticated() && (
        isAdmin() ||
        (isManager() && userBelongsToOffice(resource.data.officeId))
      );
    }
    
    // ============================================
    // Activities Subcollection
    // ============================================
    match /leads/{leadId}/activities/{activityId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || isManager());
    }
    
    // ============================================
    // Follow-ups Collection
    // ============================================
    match /followUps/{followUpId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || isManager());
    }
    
    // ============================================
    // Survey Sessions Collection
    // ============================================
    match /surveySessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // ============================================
    // Survey Responses Subcollection
    // ============================================
    match /surveySessions/{sessionId}/responses/{responseId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // ============================================
    // Imports Collection
    // ============================================
    match /imports/{importId} {
      allow read: if isAuthenticated() && (isAdmin() || isManager());
      allow write: if isAuthenticated() && (isAdmin() || isManager());
    }
    
    // ============================================
    // Offices Collection
    // ============================================
    match /offices/{officeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // ============================================
    // Teams Collection
    // ============================================
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // ============================================
    // Settings Collection
    // ============================================
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // ============================================
    // Audit Events Collection
    // ============================================
    match /auditEvents/{eventId} {
      allow read: if isAuthenticated() && (isAdmin() || isManager());
      allow write: if isAuthenticated() && (isAdmin() || isManager());
    }
    
    // ============================================
    // Sheet Sync Jobs Collection
    // ============================================
    match /sheetSyncJobs/{jobId} {
      allow read: if isAuthenticated() && (isAdmin() || isManager());
      allow write: if isAuthenticated() && (isAdmin() || isManager());
    }
  }
}
